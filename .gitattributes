# Stable text line endings and binary handling for scientific figures.
* text=auto
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.cff text eol=lf
*.toml text eol=lf
*.sbatch text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
